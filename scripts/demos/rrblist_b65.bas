10 REM RRB list mode demo for B65 BASIC (K325T XCTL bit 5): bouncing balls
20 N%=6:S%=&80000:C%=&FF84000:L%=512:G%=&1800:GA%=&60000:OA%=&89000:OC%=&7800
25 DIM P%(8):P%(0)=1:FOR J%=1 TO 8:P%(J%)=P%(J%-1)*2:NEXT
30 ?&FFD71F0=?&FFD71F0 OR &30:REM list mode + fast RRB (keep 1 MB chip RAM)
40 ?&FFD3020=0:?&FFD3021=0
50 REM full-colour ball glyphs G%+I% (64 bytes each at GA%; full-colour glyphs must be in the first 512 KB)
60 FOR I%=0 TO N%-1:K%=2+I%:IF K%>6 THEN K%=K%+1
70 RESTORE:FOR Y%=0 TO 7:READ B%:FOR X%=0 TO 7:P%=0
80 IF B% AND P%(7-X%) THEN P%=K%:IF Y%<2 THEN P%=1
90 ?(GA%+64*I%+8*Y%+X%)=P%:NEXT:NEXT
100 PROCw(OA%+16*I%,G%+I%):PROCw(OA%+16*I%+2,&FFFF):PROCw(C%-&4000+OC%+16*I%,0)
110 NEXT
120 DATA 60,126,255,255,255,255,126,60
130 REM rows: 80 stars/spaces, LIST token, 2N slots, end
140 FOR R%=0 TO 24:A%=S%+R%*L%:CA%=C%+R%*L%
150 FOR X%=0 TO 79:T%=32:IF RND(1)<.06 THEN T%=46
160 PROCw(A%+2*X%,T%):?(CA%+2*X%)=0:?(CA%+2*X%+1)=1:NEXT
170 PROCw(A%+160,&FFFC)
180 FOR K%=0 TO 2*N%-1:E%=A%+162+8*K%:I%=K% DIV 2
190 PROCw(E%,0):PROCw(E%+2,&4800):PROCw(E%+4,&9000+16*I%):PROCw(E%+6,OC%+16*I%):NEXT
200 PROCw(A%+162+16*N%,&FFFF):NEXT
210 REM VIC-IV: HOTREG off, CHR16 + full colour >$FF, LINESTEP, CHRCOUNT, pointers
220 ?&FFD305D=?&FFD305D AND 127:?&FFD3054=?&FFD3054 OR 5
230 PROCw(&FFD3058,L%):?&FFD305E=81:?&FFD3063=?&FFD3063 AND 192
240 ?&FFD3060=0:?&FFD3061=0:?&FFD3062=8:PROCw(&FFD3064,&4000)
250 DIM X%(N%),Y%(N%),DX%(N%),DY%(N%),Q%(N%)
260 FOR I%=0 TO N%-1:X%(I%)=20+RND(590):Y%(I%)=8+RND(180)
270 DX%(I%)=RND(3):DY%(I%)=RND(2):Q%(I%)=-1:NEXT
280 REPEAT
290 FOR I%=0 TO N%-1
300 X%=X%(I%)+DX%(I%):IF X%<0 OR X%>630 THEN DX%(I%)=-DX%(I%):X%=X%(I%)+DX%(I%)
310 Y%=Y%(I%)+DY%(I%):IF Y%<0 OR Y%>191 THEN DY%(I%)=-DY%(I%):Y%=Y%(I%)+DY%(I%)
320 X%(I%)=X%:Y%(I%)=Y%:R%=Y% DIV 8:O%=Y% MOD 8
330 IF R%<>Q%(I%) AND Q%(I%)>=0 THEN PROChide(Q%(I%),I%)
340 E%=S%+R%*L%+162+16*I%:PROCw(E%,X%+&1000+&2000*O%):PROCw(E%+2,&4800+256-P%(O%))
350 IF R%<24 AND O%>0 THEN PROCw(E%+L%+8,X%+&2000*(8-O%)):PROCw(E%+L%+10,&4800+P%(O%)-1)
355 IF R%<24 AND O%=0 THEN PROCw(E%+L%+10,&4800)
360 Q%(I%)=R%:NEXT
370 UNTIL FALSE
380 DEF PROCw(A%,V%):?A%=V% AND 255:?(A%+1)=(V% DIV 256) AND 255:ENDPROC
390 DEF PROChide(R%,I%):LOCAL E%:E%=S%+R%*L%+162+16*I%:PROCw(E%+2,&4800):IF R%<24 THEN PROCw(E%+L%+10,&4800)
400 ENDPROC
