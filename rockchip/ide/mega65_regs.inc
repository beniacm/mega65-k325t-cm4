CPU_OCEANA_MASK               = %00000010
CPU_SLOWCACHE                := $D7FE ; bit 2 Enable slow line caching for Attic RAM
CPU_SLOWCACHE_MASK            = %00000100
CPU_SLOWCACHE_ADV            := $D7FE ; bit 3 Enable slow line cache advance for Attic RAM
CPU_SLOWCACHE_ADV_MASK        = %00001000
CPU_SELSDRAM                 := $D7FE ; bit 4 Selects SDRAM instead of HyperRAM for Attic RAM where available
CPU_SELSDRAM_MASK             = %00010000
CPU_SLOWSDRAM                := $D7FE ; bit 5 Selects slow (81MHz) SDRAM clock
CPU_SLOWSDRAM_MASK            = %00100000
CPU_HWRNG_NOTRDY             := $D7FE ; bit 7 Hardware Real RNG random number not ready (read only)
CPU_HWRNG_NOTRDY_MASK         = %10000000
.endif
