[Unit]
Description=MEGA65 / C64 bridge I/O: m65io (SD card image, serial monitor :4510, Ethernet)
# no PartOf=m65d.service: systemd propagated m65d's automatic restarts (crash recovery) to m65io,
# a 1-2 s gap in SD service; m65d_restart.sh / m65d_stop.sh handle both units explicitly

[Service]
WorkingDirectory=/root/m65
# release the CM4 pads the bitstreams use from the boot DTB's BT1120 pinmux
ExecStartPre=/usr/bin/python3 /root/m65/rk_pins.py
ExecStartPre=/bin/sh -c '[ m65io -nt m65io.c ] || gcc -O2 -Wall -o m65io m65io.c'
ExecStartPre=-/bin/mv -f /root/m65/m65io.log /root/m65/m65io.log.1
# extra arguments until the next reboot: m65d_restart.sh <args> (systemctl set-environment)
ExecStart=/root/m65/m65io $M65IO_ARGS
StandardOutput=append:/root/m65/m65io.log
StandardError=inherit
Restart=always
RestartSec=1
