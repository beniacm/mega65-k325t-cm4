[Unit]
Description=MEGA65 / C64 bridge control: m65d (USB keyboard, gamepads, mouse; control on :4511)
# m65io (SD card image, serial monitor, Ethernet) is started with it; stop/restart of this unit
# covers both (m65io.service has PartOf=m65d.service)
# no network-online.target: the control port binds 0.0.0.0, and waiting for DHCP delayed the
# USB keyboard and the boot reset by ~19 s
Wants=m65io.service
# cpufrequtils.service (Debian) sets the 'ondemand' governor at boot: set ours after it
After=m65io.service cpufrequtils.service

[Service]
WorkingDirectory=/root/m65
# input latency: event -> SPI p50 0.44 ms with 'performance' vs 0.86 ms with 'ondemand' (no
# measurable temperature difference, the SoC stays ~57 C); SCHED_FIFO removes the multi-ms spikes
ExecStartPre=-/bin/sh -c 'for g in /sys/devices/system/cpu/cpufreq/policy*/scaling_governor; do echo performance > $$g; done'
ExecStartPre=-/bin/mv -f /root/m65/m65d.log /root/m65/m65d.log.1
ExecStart=/usr/bin/python3 -u /root/m65/m65d.py
StandardOutput=append:/root/m65/m65d.log
StandardError=inherit
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=50
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
