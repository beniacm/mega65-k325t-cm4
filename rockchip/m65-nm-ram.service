[Unit]
Description=NetworkManager state in RAM (DHCP leases), seeded from /var/lib/m65-nm
Documentation=file:///usr/local/sbin/m65-nm-ram
DefaultDependencies=no
After=local-fs.target var-lib-NetworkManager.mount
Before=NetworkManager.service network-pre.target shutdown.target
Conflicts=shutdown.target
RequiresMountsFor=/var/lib

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/m65-nm-ram start
ExecStop=/usr/local/sbin/m65-nm-ram stop

[Install]
# Wanted, not Required: if the tmpfs cannot be set up NetworkManager still starts (leases on the eMMC)
WantedBy=NetworkManager.service
