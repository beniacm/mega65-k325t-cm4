#!/usr/bin/env python3
"""m65run -- run a cross-assembled program on the MEGA65 (from the Rockchip's shell, vim F5, ...).

    m65run prog.prg            load at the PRG's address, start it with SYS <stub address>
    m65run prog.prg --sys N    start with SYS N (decimal or 0x hex)
    m65run prog.prg --run      start with RUN
    m65run prog.prg --load     only load
    m65run prog.prg --reset    reset the MEGA65 to BASIC READY first

Writes the PRG through the serial monitor (binary load, ~190 KB/s) and starts it:
  * MEGA65 at the BASIC READY prompt: types SYS <address> (stub '10 SYS n') or RUN (other stubs,
    e.g. llvm-mos's '10 BANK 0 : 20 SYS n')
  * llvm-mos C programs (stub '10 BANK 0 : 20 SYS n') never return to BASIC -- their start
    code maps the BASIC ROM out and the CPU ends in BRA *.  Next C program: stop the CPU, load,
    set the PC to the stub's SYS address, run (the start code sets up the rest itself).
  * a BASIC-style program after a C program (or with the CPU parked): BASIC is broken, so the
    MEGA65 core is reset first and m65run waits for READY. (leaving the start menu with '/').
    The kind of the last program is kept in /tmp/m65run.last.
Afterwards the HDMI output and the keyboard are switched to the MEGA65 (m65d 'view mega65').
Back to the Linux picture (vim, the shell): Ctrl+Alt+Insert."""
import socket
import sys
import time


def ctl(cmd, port=4511, timeout=10):
    with socket.create_connection(("127.0.0.1", port), timeout=timeout) as s:
        s.sendall((cmd + "\n").encode())
        buf = b""
        while not buf.endswith(b"\n"):
            d = s.recv(4096)
            if not d:
                break
            buf += d
    return buf.decode().strip()


LAST = "/tmp/m65run.last"
VIC = 0xFFD3000


def scr_codes(text):
    """upper-case screen codes as BASIC prints them (A-Z = 1-26)"""
    return bytes(ord(c) - 64 if "A" <= c <= "Z" else ord(c) for c in text)


class Monitor:
    def __init__(self):
        self.s = socket.create_connection(("127.0.0.1", 4510), timeout=5)
        self.s.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        self.s.settimeout(0.05)
        try:
            while self.s.recv(65536):
                pass
        except socket.timeout:
            pass

    def cmd(self, c, raw=b""):
        self.s.setblocking(False)           # the pipe sends every client's output to all
        try:                                # clients: drop what is already buffered
            while self.s.recv(65536):
                pass
        except (BlockingIOError, InterruptedError):
            pass
        self.s.setblocking(True)
        self.s.sendall(c.encode() + b"\r" + raw)
        out, t0 = b"", time.time()
        self.s.settimeout(3)
        while not out.rstrip(b"\r\n ").endswith(b"\n.") and time.time() - t0 < 5:
            out += self.s.recv(65536)
        return out.decode(errors="replace")

    def load(self, addr, data):
        for o in range(0, len(data), 4096):
            chunk = data[o:o + 4096]
            a = addr + o
            self.cmd("l%x %x" % (a, (a + len(chunk)) & 0xFFFF), chunk)

    def read(self, addr, n):
        data = b""
        while len(data) < n:
            got = b""
            for line in self.cmd("M%x" % (addr + len(data))).splitlines():
                if line.startswith(":") and line.count(":") >= 2:
                    got += bytes.fromhex(line.split(":")[2].strip())
            if not got:
                break
            data += got
        return data[:n]

    def screen(self):
        """the current text screen's bytes (screen pointer and size from the VIC-IV)"""
        r = self.read(VIC, 0x80)
        if len(r) < 0x80:
            return b""
        ptr = r[0x60] | r[0x61] << 8 | r[0x62] << 16
        size = (r[0x58] | r[0x59] << 8) * (r[0x7B] + 1)
        return self.read(ptr, min(size, 8192))

    def reset_to_basic(self, timeout=40):
        """reset the MEGA65 core and wait for BASIC's READY. (leave the start menu with '/')"""
        print("m65run: resetting the MEGA65 (BASIC is not usable after the last program)")
        ctl("reset")
        t0, slashed = time.time(), False
        time.sleep(3)
        while time.time() - t0 < timeout:
            scr = self.screen()
            if scr_codes("READY.") in scr:
                time.sleep(0.3)
                return True
            if not slashed and scr_codes("MENU SYSTEM") in scr:
                ctl("key /")
                slashed = True
            time.sleep(0.5)
        return False

    def parked(self):
        """True if the CPU spins in BRA * / JMP * (a finished program's end loop): the monitor's
        'r' disassembles the current instruction, e.g. ',077720AC  80 FE     BRA   $20AC'.
        (The PC itself alternates between the loop and the next address while sampled.)"""
        for _ in range(4):
            for line in self.cmd("r").splitlines():
                f = line.split()
                if line.startswith(",") and len(f) >= 4:
                    pc = int(f[0][-4:], 16)
                    ops = [x.upper() for x in f[1:]]
                    for mn in ("BRA", "JMP"):
                        if mn in ops and ops.index(mn) + 1 < len(ops):
                            tgt = ops[ops.index(mn) + 1].lstrip("$")
                            if all(c in "0123456789ABCDEF" for c in tgt) and tgt and int(tgt, 16) == pc:
                                return True
        return False


def stub_sys(addr, data, any_line=False):
    """address in a BASIC stub '10 SYS nnnn' (C64 V2 and BASIC 65 both use token $9E);
    any_line: also later lines (llvm-mos: '10 BANK 0 : 20 SYS n')"""
    if any_line:
        p = 0
        while p + 4 <= len(data):
            nxt = (data[p] | data[p + 1] << 8) - addr
            if nxt <= p or nxt > len(data):
                break
            n = stub_sys(addr, data[p:])
            if n is not None:
                return n
            p = nxt
        return None
    p = 4
    if len(data) > p and data[p] == 0x9E:
        p += 1
        while p < len(data) and data[p] in b" (":
            p += 1
        digits = b""
        while p < len(data) and 0x30 <= data[p] <= 0x39:
            digits += bytes([data[p]])
            p += 1
        if digits:
            return int(digits)
    return None


def main():
    a = sys.argv[1:]
    if not a or a[0].startswith("-"):
        sys.exit(__doc__)
    raw = open(a[0], "rb").read()
    addr, data = raw[0] | raw[1] << 8, raw[2:]
    r = ctl("status")                              # m65d reachable?
    if not r.startswith("ok"):
        sys.exit("m65run: " + r)
    mon = Monitor()
    entry = int(a[a.index("--sys") + 1], 0) if "--sys" in a else stub_sys(addr, data, any_line=True)
    is_c = len(data) > 5 and data[4] == 0xFE        # llvm-mos stub: 10 BANK 0 (token $FE $02)
    try:
        last = open(LAST).read().strip()
    except OSError:
        last = ""
    if "--load" not in a and not is_c and ("--reset" in a or last == "c" or mon.parked()):
        if not mon.reset_to_basic():
            sys.exit("m65run: no READY. after the reset (check the MEGA65 screen)")
    try:
        open(LAST, "w").write("c" if is_c else "basic")
    except OSError:
        pass
    if "--load" not in a and is_c and entry is not None and mon.parked():
        mon.cmd("t1")                              # stop the parked CPU, load, start directly
        mon.load(addr, data)
        mon.cmd("g%x" % entry)
        mon.cmd("t0")
        print("m65run: %d bytes at $%04x, started at $%04x (CPU was parked)" % (len(data), addr, entry))
        ctl("view mega65")
        return
    mon.load(addr, data)
    print("m65run: %d bytes at $%04x" % (len(data), addr))
    if "--load" in a:
        return
    if "--run" in a:
        start = "RUN"
    elif "--sys" in a:
        start = "SYS %d" % int(a[a.index("--sys") + 1], 0)
    else:
        n = stub_sys(addr, data)
        start = "SYS %d" % n if n is not None else "RUN"
    time.sleep(0.2)
    ctl("type " + start + "\\n")
    print("m65run: typed %s" % start)
    ctl("view mega65")                             # picture + keyboard to the MEGA65


if __name__ == "__main__":
    main()
