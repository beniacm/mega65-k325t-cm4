# upstream core is its own git repo (branch qmtech-k325t-cm4)
/mega65-core/
/ext/
/logs/
/captures/
/sdimage/*.img
/sdimage/extra/*
# GHDL build products
/sim/*.cf
/sim/*.o
/sim/tb_rk_sd
/sim/e~*
__pycache__/
/sim/sdcard_simcopy.vhdl
/sdimage/rompatch/
# copyrighted ROM images never go into git
*.ROM
*.rom
*.bin
/sim/uart_tx_simcopy.vhdl
# C64 core (its own git repo, branch qmtech-k325t-cm4) and downloaded third-party games
/c64mega65/
/c64games/
/c64test/*.d64
